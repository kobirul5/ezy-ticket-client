# Frontend Client Environment Variables Example

# =========================================================
# BACKEND SERVER CONFIGURATION
# Toggle between Local and Live backend URLs by commenting / uncommenting
# =========================================================

# --- 1. LOCAL BACKEND ---
VITE_SERVER_URL="http://localhost:5000"
VITE_API_URL="http://localhost:5000/api/v1"

# --- 2. LIVE BACKEND ---
# VITE_SERVER_URL="https://ezy-ticket-server-eta.vercel.app"
# VITE_API_URL="https://ezy-ticket-server-eta.vercel.app/api/v1"

# =========================================================
# OTHER CONFIGURATIONS
# =========================================================

# Stripe Publishable Key (for payment integration)
VITE_PAYMENT_PK="pk_test_your_stripe_publishable_key"

